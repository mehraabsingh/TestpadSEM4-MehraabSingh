class Date {
    private int month;
    private int day;

    public Date(int m, int d) {
        this.month = m;
        this.day = d;
    }

    public int daysInMonth() {
        switch (month) {
            case 1: return 31;
            case 2: return 28;
            case 3: return 31;
            case 4: return 30;
            case 5: return 31;
            case 6: return 30;
            case 7: return 31;
            case 8: return 31;
            case 9: return 30;
            case 10: return 31;
            case 11: return 30;
            case 12: return 31;
            default: return 0;
        }
    }

    public int getDay() {
        return day;
    }

    public int getMonth() {
        return month;
    }

    public void nextDay() {
        day++;
        if (day > daysInMonth()) {
            day = 1;
            month++;
            if (month > 12) {
                month = 1;
            }
        }
    }

    public String toString() {
        return month + "/" + day;
    }

    public int absoluteDay() {
        int totalDays = 0;
        for (int m = 1; m < month; m++) {
            totalDays += daysInMonth(m);
        }
        totalDays += day;
        return totalDays;
    }

    private int daysInMonth(int m) {
        switch (m) {
            case 1: return 31;
            case 2: return 28;
            case 3: return 31;
            case 4: return 30;
            case 5: return 31;
            case 6: return 30;
            case 7: return 31;
            case 8: return 31;
            case 9: return 30;
            case 10: return 31;
            case 11: return 30;
            case 12: return 31;
            default: return 0;
        }
    }
}
