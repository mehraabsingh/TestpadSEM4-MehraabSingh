static void mirrorQueue(Queue<String> q) {
    int originalSize = q.size();
    Stack<String> stack = new Stack<>();

    for (int i = 0; i < originalSize; i++) {
        String element = q.poll();
        q.add(element);
        stack.push(element);
    }

    while (!stack.isEmpty()) {
        q.add(stack.pop());
    }
}
