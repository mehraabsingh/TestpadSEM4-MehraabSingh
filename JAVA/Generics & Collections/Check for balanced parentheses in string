class Result{
  static int balancedString(String s){
    Stack<Character> stack = new Stack<>();
    
    for (int i = 0; i < s.length(); i++) {
      char ch = s.charAt(i);
      
      if (ch == '(' || ch == '{') {
        stack.push(ch);
      } else if (ch == ')' || ch == '}') {
        if (stack.isEmpty()) {
          return i;
        }
        
        char top = stack.pop();
        
        if ((ch == ')' && top != '(') || (ch == '}' && top != '{')) {
          return i;
        }
      }
    }
    
    return stack.isEmpty() ? -1 : s.length();
  }
}
