static void countLines(String f1) {
    try {
        BufferedReader reader = new BufferedReader(new FileReader(f1));
        String line;
        int totalLines = 0;
        int blankLines = 0;

        while ((line = reader.readLine()) != null) {
            totalLines++;
            if (line.trim().isEmpty()) {
                blankLines++;
            }
        }

        System.out.println(totalLines + " " + blankLines);
        reader.close();
    } catch (IOException e) {
        e.printStackTrace();
    }
}
