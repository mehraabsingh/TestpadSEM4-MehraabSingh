#include <stdio.h>
#include <stdlib.h>
int* cutSticks(int lengths_size, int *lengths, int *result_size) {
    int *result = (int *)malloc(lengths_size * sizeof(int));
    int count = 0;
    while (lengths_size > 0) {
        result[count++] = lengths_size;
        int min = 1001;
        for (int i = 0; i < lengths_size; i++) 
            if (lengths[i] > 0 && lengths[i] < min) 
                min = lengths[i];
        int new_size = 0;
        for (int i = 0; i < lengths_size; i++) {
            lengths[i] -= min;
            if (lengths[i] > 0)
                lengths[new_size++] = lengths[i];
        }
        lengths_size = new_size;
    }
    *result_size = count;
    return result;
}
