static void printInorder(Node root) {
  Stack<Node> stack = new Stack<>();
  Node current = root;

  while (current != null || !stack.isEmpty()) {
    while (current != null) {
      stack.push(current);
      current = current.leftChild;
    }
    current = stack.pop();
    System.out.print(current.data + " ");
    current = current.rightChild;
  }
}
