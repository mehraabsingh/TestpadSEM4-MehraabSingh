
static Node buildTree(int arr[], int n) {
  if (n == 0) return null;
  
  Node root = new Node(arr[0]);
  Queue<Node> queue = new LinkedList<>();
  queue.add(root);
  
  int i = 1;
  while (i < n) {
    Node temp = queue.poll();
    
    if (i < n) {
      temp.left = new Node(arr[i++]);
      queue.add(temp.left);
    }
    
    if (i < n) {
      temp.right = new Node(arr[i++]);
      queue.add(temp.right);
    }
  }
  
  return root;
}
