class Result {
  static Node buildTree(int in[], int post[], int N) {
    if (N == 0) return null;
    Map<Integer, Integer> inMap = new HashMap<>();
    for (int i = 0; i < N; i++) inMap.put(in[i], i);
    return buildTreeHelper(in, post, 0, N - 1, 0, N - 1, inMap);
  }

  static Node buildTreeHelper(int in[], int post[], int inStart, int inEnd, int postStart, int postEnd, Map<Integer, Integer> inMap) {
    if (inStart > inEnd || postStart > postEnd) return null;
    Node root = new Node(post[postEnd]);
    int rootIndex = inMap.get(root.data);
    int leftSize = rootIndex - inStart;
    root.leftChild = buildTreeHelper(in, post, inStart, rootIndex - 1, postStart, postStart + leftSize - 1, inMap);
    root.rightChild = buildTreeHelper(in, post, rootIndex + 1, inEnd, postStart + leftSize, postEnd - 1, inMap);
    return root;
  }
}
