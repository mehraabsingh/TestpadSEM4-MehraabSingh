long solveQuery(int N, int W, int i, char ch) {
    long total_rows = (N + W - 1) / W; 
    if (ch == 'R') {
        if (i > total_rows) {
            return 0; 
        }
        long start = (i - 1) * W + 1;
        long end = (i * W < N) ? (i * W) : N; 
        return (end >= start) ? (end - start + 1) * (start + end) / 2 : 0; 
    } else if (ch == 'C') {
        if (i > W) {
            return 0; 
        }
        long sum = 0;
        for (long k = 0; i + k * W <= N; k++) {
            sum += (i + k * W); 
        }
        return sum;
    }
    return 0; 
}
