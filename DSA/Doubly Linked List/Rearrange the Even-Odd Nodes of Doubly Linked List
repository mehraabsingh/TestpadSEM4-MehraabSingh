struct Node* rearrangeList(struct Node* head) {
    if (!head || !head->next) return head;

    struct Node *evenHead = NULL, *evenTail = NULL;
    struct Node *oddHead = NULL, *oddTail = NULL;
    struct Node *curr = head;
    int pos = 1;

    while (curr) {
        struct Node* next = curr->next;
        curr->prev = curr->next = NULL;
        
        if (pos % 2 == 0) {
            if (!evenHead) evenHead = evenTail = curr;
            else {
                evenTail->next = curr;
                curr->prev = evenTail;
                evenTail = curr;
            }
        } else {
            if (!oddHead) oddHead = oddTail = curr;
            else {
                oddTail->next = curr;
                curr->prev = oddTail;
                oddTail = curr;
            }
        }
        curr = next;
        pos++;
    }

    if (!evenHead) return oddHead;
    evenTail->next = oddHead;
    if (oddHead) oddHead->prev = evenTail;

    return evenHead;
}
