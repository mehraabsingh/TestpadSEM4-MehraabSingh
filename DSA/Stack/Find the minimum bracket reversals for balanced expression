import java.util.*;

class Result {
  static int minReversal(String expr) {
    int n = expr.length();
    if (n % 2 != 0) return -1;

    int open = 0, close = 0;
    for (char ch : expr.toCharArray()) {
      if (ch == '[') {
        open++;
      } else {
        if (open > 0) {
          open--;
        } else {
          close++;
        }
      }
    }

    return (int) (Math.ceil(open / 2.0) + Math.ceil(close / 2.0));
  }
}
