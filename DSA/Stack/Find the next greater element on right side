import java.util.*;

class Result {
  static void printNextGreaterElement(int arr[], int n) {
    Stack<Integer> stack = new Stack<>();
    int[] nge = new int[n];

    for (int i = n - 1; i >= 0; i--) {
      while (!stack.isEmpty() && stack.peek() <= arr[i]) {
        stack.pop();
      }
      nge[i] = stack.isEmpty() ? -1 : stack.peek();
      stack.push(arr[i]);
    }

    for (int num : nge) {
      System.out.print(num + " ");
    }
  }
}
